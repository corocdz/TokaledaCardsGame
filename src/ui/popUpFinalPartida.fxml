<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!--
    PopUp de fin de partida.
    Se muestra sobre la pantalla de juego como overlay.
    El controller (PopUpFinalPartidaController) rellena
    lblTitulo, lblResultado y lblDetalle con los datos del modo.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ui.PopUpFinalPartidaController"
           style="-fx-background-color: rgba(0,0,0,0.72);"
           prefWidth="1280" prefHeight="720">

    <VBox alignment="CENTER" spacing="24"
          style="-fx-background-color: rgba(20,20,30,0.97);
                 -fx-background-radius: 18;
                 -fx-padding: 48 64 48 64;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 30, 0.4, 0, 0);"
          maxWidth="560" maxHeight="420">

        <ImageView fx:id="imgIcono"
                   fitWidth="120"
                   preserveRatio="true"/>


        <!-- Título principal -->
        <Label fx:id="lblTitulo" text=""
               wrapText="true"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;
                      -fx-text-alignment: center;"/>

        <!-- Resultado (ganador o empate) -->
        <Label fx:id="lblResultado" text=""
               wrapText="true"
               style="-fx-font-size: 22px;
                      -fx-text-fill: #f0c040;
                      -fx-font-weight: bold;
                      -fx-text-alignment: center;"/>

        <!-- Detalle adicional (puntos, vidas, etc.) -->
        <Label fx:id="lblDetalle" text=""
               wrapText="true"
               style="-fx-font-size: 16px;
                      -fx-text-fill: #aaaaaa;
                      -fx-text-alignment: center;"/>

        <!-- Botones -->
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="16"/>
            </padding>            
            
            <Button fx:id="btnVolverJugar"
                    onAction="#onJugarDeNuevo"
                    pickOnBounds="false"
                    style="
            -fx-background-color: transparent;
            -fx-padding: 0;
            -fx-background-insets: 0;
            -fx-background-radius: 0;
            -fx-focus-color: transparent;
            -fx-faint-focus-color: transparent;
        ">
                <graphic>
                    <ImageView fx:id="btnVolverJugarImage" fitWidth="380" preserveRatio="true">
                        <image>
                            <Image url="@graphicResources/imagenes/btnVolverJugar.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            
            <Button fx:id="btnIrSala"
                    onAction="#onVolverSala"
                    pickOnBounds="false"
                    style="
            -fx-background-color: transparent;
            -fx-padding: 0;
            -fx-background-insets: 0;
            -fx-background-radius: 0;
            -fx-focus-color: transparent;
            -fx-faint-focus-color: transparent;
        ">

                <graphic>
                    <ImageView fx:id="btnIrSalaImage" fitWidth="380" preserveRatio="true">
                        <image>
                            <Image url="@graphicResources/imagenes/btnIrSala.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            
            
        </HBox>

    </VBox>
</StackPane>
