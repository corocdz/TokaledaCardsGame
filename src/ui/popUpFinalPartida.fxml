<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    PopUp de fin de partida.
    Se muestra sobre la pantalla de juego como overlay.
    El controller (PopUpFinalPartidaController) rellena
    lblTitulo, lblResultado y lblDetalle con los datos del modo.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="ui.PopUpFinalPartidaController"
           style="-fx-background-color: rgba(0,0,0,0.72);"
           prefWidth="1280" prefHeight="720">

    <VBox alignment="CENTER" spacing="24"
          style="-fx-background-color: rgba(20,20,30,0.97);
                 -fx-background-radius: 18;
                 -fx-padding: 48 64 48 64;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 30, 0.4, 0, 0);"
          maxWidth="560" maxHeight="420">

        <!-- Icono / emoji grande -->
        <Label fx:id="lblIcono" text="🎉"
               style="-fx-font-size: 56px;"/>

        <!-- Título principal -->
        <Label fx:id="lblTitulo" text="¡La partida ha terminado!"
               wrapText="true"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;
                      -fx-text-alignment: center;"/>

        <!-- Resultado (ganador o empate) -->
        <Label fx:id="lblResultado" text=""
               wrapText="true"
               style="-fx-font-size: 22px;
                      -fx-text-fill: #f0c040;
                      -fx-font-weight: bold;
                      -fx-text-alignment: center;"/>

        <!-- Detalle adicional (puntos, vidas, etc.) -->
        <Label fx:id="lblDetalle" text=""
               wrapText="true"
               style="-fx-font-size: 16px;
                      -fx-text-fill: #aaaaaa;
                      -fx-text-alignment: center;"/>

        <!-- Botones -->
        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="16"/></padding>

            <Button fx:id="btnJugarDeNuevo" text="🔄 Jugar de nuevo"
                    onAction="#onJugarDeNuevo"
                    style="-fx-font-size: 15px;
                           -fx-padding: 10 24;
                           -fx-background-color: #2e7d32;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnVolverSala" text="🚪 Volver a la sala"
                    onAction="#onVolverSala"
                    style="-fx-font-size: 15px;
                           -fx-padding: 10 24;
                           -fx-background-color: #1565c0;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</StackPane>
